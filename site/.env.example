# ─── Mercado Pago (aplicação PWU CHECKOUT PRO — Checkout Pro + API de Orders) ───
# Access Token — SECRETO. Só em variável de ambiente do servidor (Vercel).
MP_ACCESS_TOKEN=
# Chave secreta da assinatura do webhook (painel > Webhooks).
MP_WEBHOOK_SECRET=
# ─── App ───
APP_URL=https://pokeworld-universe.vercel.app
# ─── Supabase (servidor) ───
SUPABASE_URL=
# service_role — SECRETA. Nunca no frontend. Usada só pelas funções em /api.
SUPABASE_SERVICE_ROLE_KEY=
