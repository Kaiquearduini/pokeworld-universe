{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/Donate",
      "destination": "/doar.html"
    },
    {
      "source": "/donate",
      "destination": "/doar.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/minha-conta",
      "destination": "/minha-conta.html"
    },
    {
      "source": "/ranking",
      "destination": "/ranking.html"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/o-jogo",
      "destination": "/o-jogo.html"
    }
  ],
  "redirects": [
    {
      "source": "/doar",
      "destination": "/Donate",
      "permanent": true
    },
    {
      "source": "/doar.html",
      "destination": "/Donate",
      "permanent": true
    },
    {
      "source": "/loja",
      "destination": "/Donate",
      "permanent": false
    },
    {
      "source": "/loja.html",
      "destination": "/Donate",
      "permanent": false
    },
    {
      "source": "/wiki",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wiki.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
