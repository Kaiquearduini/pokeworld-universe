{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/minha-conta",
      "destination": "/minha-conta.html"
    },
    {
      "source": "/ranking",
      "destination": "/ranking.html"
    },
    {
      "source": "/loja",
      "destination": "/loja.html"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/wiki",
      "destination": "/wiki.html"
    },
    {
      "source": "/o-jogo",
      "destination": "/o-jogo.html"
    }
  ]
}